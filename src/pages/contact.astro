---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <Navigation />

  <!-- ============================================ -->
<!--                Contact Form                  -->
<!-- ============================================ -->

<section id="cs-contact-490">
    <div class="cs-container">
        <div class="cs-content">
            <h1 class="cs-title">Get in Touch</h1>
        </div>
        <!-- Form -->
        <form id="cs-form-490" name="Contact Form" method="post" netlify-honeypot="bot-field" data-netlify="true">
            <!-- Netlify form name -->
            <input type="hidden" name="form-name" value="Contact Form" />

            <!-- Honeypot field for spam prevention -->
            <p class="cs-honeypot">
                <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <label class="cs-label">
                Name
                <input class="cs-input" required type="text" id="name-490" name="name" placeholder="Your Name">
            </label>
            <label class="cs-label">
                Email
                <input class="cs-input" required type="email" id="email-490" name="email" placeholder="name@email.com">
            </label>
            <label class="cs-label">
                Phone
                <input class="cs-input" type="tel" id="phone-490" name="phone" placeholder="(optional)">
            </label>
            <label class="cs-label">
                How Did You Find Me?
                <input class="cs-input" type="text" id="find-490" name="find-us" placeholder="Referral, search, social media...">
            </label>
            <label class="cs-label-message">
                Message
                <textarea class="cs-input" required name="message" id="message-490" placeholder="Tell me about your project or what you're looking for help with..."></textarea>
            </label>
            <button class="cs-button-solid" type="submit">Send Message</button>
        </form>
    </div>
</section>

    <Footer />
</Layout>

<style lang="less">

/*-- -------------------------- -->
<---          Contact           -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #cs-contact-490 {
        background-color: var(--secondary);
        /* 144px - 200px - extra padding for nav height */
        padding: clamp(9rem, 15vw, 12.5rem) (16/16rem) var(--sectionPadding);

        .cs-container {
            width: 100%;
            max-width: (700/16rem);
            margin: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: clamp(2rem, 4vw, 3rem);
        }

        .cs-content {
            width: 100%;
            text-align: center;
        }

        .cs-title {
            /* 32px - 48px */
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 900;
            line-height: 1.2em;
            text-align: center;
            margin: 0 auto;
            color: var(--headerColor);
        }

        .cs-honeypot {
            position: absolute;
            left: -9999px;
            opacity: 0;
            height: 0;
            overflow: hidden;
        }

        #cs-form-490 {
            width: 100%;
            /* 24px - 48px */
            padding: clamp(1.5rem, 4vw, 3rem);
            background-color: #fff;
            border-radius: (12/16rem);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
            box-sizing: border-box;
        }

        .cs-label {
            font-size: (14/16rem);
            font-weight: 700;
            line-height: 1.5em;
            width: 100%;
            margin-bottom: (12/16rem);
            color: var(--headerColor);
            display: flex;
            flex-direction: column;
            gap: (4/16rem);
        }

        .cs-label-message {
            margin-bottom: (12/16rem);

            .cs-input {
                min-height: (120/16rem);
                padding: (16/16rem);
                font-family: inherit;
                resize: vertical;
            }
        }

        .cs-input {
            font-size: (16/16rem);
            width: 100%;
            height: (56/16rem);
            padding: 0 (16/16rem);
            background-color: #f7f7f7;
            color: var(--headerColor);
            border: 1px solid #e8e8e8;
            border-radius: (8/16rem);
            box-sizing: border-box;
            transition: border-color 0.3s;

            &::placeholder {
                color: #9ca3af;
            }

            &:hover,
            &:focus {
                border-color: var(--primary);
                outline: none;
            }
        }

        .cs-button-solid {
            font-size: (16/16rem);
            font-weight: 700;
            line-height: (56/16rem);
            text-decoration: none;
            text-align: center;
            width: 100%;
            margin-top: (12/16rem);
            padding: 0 (24/16rem);
            background-color: var(--primary);
            color: #fff;
            border: none;
            border-radius: (8/16rem);
            cursor: pointer;
            transition: background-color 0.3s;

            &:hover {
                background-color: var(--headerColor);
            }
        }
    }
}

/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
    #cs-contact-490 {
        .cs-container {
            max-width: (800/16rem);
        }

        #cs-form-490 {
            /* 40px - 64px */
            padding: clamp(2.5rem, 5vw, 4rem);
        }
    }
}

</style>
